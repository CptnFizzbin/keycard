{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "nodenext",
    "target": "es2025",
    "lib": [
      "ES2025"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "paths.ts",
    "*.config.ts"
  ]
}
